{
  "_aciklama": "Kurumsal Linux Sunucusu Gerçekçi Systemd Servis Envanteri (Örnek Veri)",
  "tarih": "2026-11-02",
  "sunucu_adi": "prod-app-srv01.kurumsal.yerel",
  "services": [
    {
      "name": "nginx.service",
      "path": "/lib/systemd/system/nginx.service",
      "file_owner": "root",
      "file_group": "root",
      "file_mode": "0644",
      "description": "A high performance web server and a reverse proxy server",
      "user": "www-data",
      "group": "www-data",
      "exec_start": "/usr/sbin/nginx -g 'daemon on; master_process on;'",
      "binary_owner": "root",
      "binary_mode": "0755",
      "binary_suid": false,
      "no_new_privileges": true,
      "protect_system": "strict",
      "protect_home": "yes",
      "private_tmp": true,
      "private_devices": true,
      "protect_kernel_tunables": true,
      "protect_control_groups": true,
      "capability_bounding_set": [
        "CAP_NET_BIND_SERVICE"
      ],
      "restrict_address_families": [
        "AF_UNIX",
        "AF_INET",
        "AF_INET6"
      ],
      "enabled": true,
      "active": true,
      "masked": false
    },
    {
      "name": "api-backend.service",
      "path": "/etc/systemd/system/api-backend.service",
      "file_owner": "root",
      "file_group": "root",
      "file_mode": "0644",
      "description": "Kurumsal Mikroservis REST API Sunucusu",
      "user": "apiuser",
      "group": "apiuser",
      "exec_start": "/opt/app/bin/api-server --config /etc/app/config.json",
      "binary_owner": "root",
      "binary_mode": "0755",
      "binary_suid": false,
      "no_new_privileges": true,
      "protect_system": "full",
      "protect_home": "yes",
      "private_tmp": true,
      "private_devices": true,
      "protect_kernel_tunables": true,
      "protect_control_groups": true,
      "capability_bounding_set": [
        "CAP_NET_BIND_SERVICE"
      ],
      "restrict_address_families": [
        "AF_INET",
        "AF_INET6"
      ],
      "enabled": true,
      "active": true,
      "masked": false
    },
    {
      "name": "telnet.socket",
      "path": "/lib/systemd/system/telnet.socket",
      "file_owner": "root",
      "file_group": "root",
      "file_mode": "0644",
      "description": "Telnet Server Activation Socket (Gereksiz Legacy Servis)",
      "user": "root",
      "group": "root",
      "exec_start": "/usr/sbin/in.telnetd",
      "binary_owner": "root",
      "binary_mode": "0755",
      "binary_suid": false,
      "no_new_privileges": false,
      "protect_system": "",
      "protect_home": "",
      "private_tmp": false,
      "private_devices": false,
      "enabled": true,
      "active": true,
      "masked": false
    },
    {
      "name": "legacy-worker.service",
      "path": "/etc/systemd/system/legacy-worker.service",
      "file_owner": "developer",
      "file_group": "developer",
      "file_mode": "0666",
      "description": "Eski Arka Plan İşlemcisi (Güvensiz Yapılandırma)",
      "user": "root",
      "group": "root",
      "exec_start": "/opt/worker/bin/run_worker.sh",
      "binary_owner": "developer",
      "binary_mode": "0777",
      "binary_suid": false,
      "no_new_privileges": false,
      "protect_system": "no",
      "protect_home": "no",
      "private_tmp": false,
      "private_devices": false,
      "enabled": true,
      "active": true,
      "masked": false
    },
    {
      "name": "debug-monitor.service",
      "path": "/etc/systemd/system/debug-monitor.service",
      "file_owner": "root",
      "file_group": "root",
      "file_mode": "0644",
      "description": "Sistem Hata Ayıklama İzleme Servisi (Aşırı Yetkili)",
      "user": "monuser",
      "group": "monuser",
      "exec_start": "/usr/local/bin/sysmon",
      "binary_owner": "root",
      "binary_mode": "4755",
      "binary_suid": true,
      "no_new_privileges": false,
      "protect_system": "strict",
      "protect_home": "yes",
      "private_tmp": true,
      "private_devices": false,
      "capability_bounding_set": [
        "CAP_SYS_ADMIN",
        "CAP_SYS_PTRACE"
      ],
      "enabled": true,
      "active": true,
      "masked": false
    }
  ]
}
