{
  "_aciklama": "Linux Audit ve Journal Güvenliği 9 Adet Negatif ve Sınır Durum Test Senaryosu",
  "scenarios": [
    {
      "id": "NEG_AUD_01",
      "baslik": "auditd Servisinin Kapalı / Durdurulmuş Olması",
      "aciklama": "auditd is_active=false durumu. Motor AUD-001 (CRITICAL / CWE-778) tespit etmelidir.",
      "auditd": {
        "is_active": false,
        "is_enabled_on_boot": true,
        "watch_rules": [],
        "syscall_rules": []
      },
      "journald": { "storage": "persistent" },
      "beklenen_kural": "AUD-001",
      "beklenen_sonuc": "PASS"
    },
    {
      "id": "NEG_AUD_02",
      "baslik": "auditd Servisinin Açılışta Başlamaması",
      "aciklama": "is_enabled_on_boot=false olması durumu (AUD-001 / T1562.002).",
      "auditd": {
        "is_active": true,
        "is_enabled_on_boot": false,
        "watch_rules": [],
        "syscall_rules": []
      },
      "journald": { "storage": "persistent" },
      "beklenen_kural": "AUD-001",
      "beklenen_sonuc": "PASS"
    },
    {
      "id": "NEG_AUD_03",
      "baslik": "/etc/shadow Dosyasında Watch Kuralı Eksikliği",
      "aciklama": "Parola özetlerinin izlenmemesi (AUD-002 / CWE-778 / T1003).",
      "auditd": {
        "is_active": true,
        "is_enabled_on_boot": true,
        "watch_rules": [
          { "path": "/etc/passwd", "permissions": "wa", "key": "identity" },
          { "path": "/etc/sudoers", "permissions": "wa", "key": "actions" }
        ],
        "syscall_rules": [
          { "action": "always,exit", "syscalls": ["init_module", "delete_module"], "key": "modules" }
        ]
      },
      "journald": { "storage": "persistent" },
      "beklenen_kural": "AUD-002",
      "beklenen_sonuc": "PASS"
    },
