{
  "_aciklama": "Kurumsal Linux Sunucusu Auditd ve Journald Yapılandırma Envanteri (Örnek Veri)",
  "tarih": "2026-11-02",
  "sunucu_adi": "db-cluster01.kurumsal.yerel",
  "auditd": {
    "is_active": true,
    "is_enabled_on_boot": true,
    "max_log_file": 50,
    "max_log_file_action": "keep_logs",
    "space_left_action": "email",
    "admin_space_left_action": "halt",
    "disk_full_action": "ignore",
    "log_file": "/var/log/audit/audit.log",
    "log_file_mode": "0600",
    "immutable_flag": false,
    "watch_rules": [
      {
        "path": "/etc/shadow",
        "permissions": "wa",
        "key": "identity"
      },
      {
        "path": "/etc/passwd",
        "permissions": "wa",
        "key": "identity"
      }
    ],
    "syscall_rules": [
      {
        "action": "always,exit",
        "syscalls": [
          "init_module",
          "delete_module"
        ],
        "arch": "b64",
        "key": "modules"
      }
    ]
  },
  "journald": {
    "storage": "volatile",
    "compress": true,
    "seal": false,
    "forward_to_syslog": true,
    "is_active": true
  }
}
