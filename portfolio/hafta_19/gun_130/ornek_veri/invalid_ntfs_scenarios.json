[
  {
    "scenario_id": "NEG-NTFS-01",
    "name": "Kritik Sistem İkilisinde Everyone Tam Yetkisi (FullControl)",
    "description": "System32 altındaki kritik bir çalıştırılabilir dosyaya Everyone grubuna tam yetki verilmiştir.",
    "expected_cwe": "CWE-732",
    "expected_mitre": "T1574.009",
    "expected_finding": "Zayıf NTFS İzni",
    "spec": {
      "target_system": "TEST-HOST-01",
      "descriptors": [
        {
          "path": "C:\\Windows\\System32\\cmd.exe",
          "dacl": [
            {
              "identity": "Everyone",
              "ace_type": "AccessAllowed",
              "rights": ["FullControl"]
            }
          ]
        }
      ]
    }
  },
  {
    "scenario_id": "NEG-NTFS-02",
