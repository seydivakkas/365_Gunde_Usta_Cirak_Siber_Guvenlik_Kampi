  {
    "scenario_id": "NEG-NTFS-05",
    "name": "Kanonik Olmayan Bozuk ACE Sıralaması",
    "description": "Explicit Allow kuralı Explicit Deny kuralından önce gelerek kural sıralamasını bozmuştur.",
    "expected_cwe": "CWE-284",
    "expected_mitre": "T1548",
    "expected_finding": "Kanonik Olmayan ACE Sıralaması",
    "spec": {
